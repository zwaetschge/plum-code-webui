<?xml version="1.0" encoding="utf-8"?>
<!-- Same policy as the phone app: the watch connects to whatever server URL the
     phone pairs it with, including a plain-HTTP server on the local network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
