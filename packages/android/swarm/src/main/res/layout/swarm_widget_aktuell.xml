<?xml version="1.0" encoding="utf-8"?>
<!-- Widget „Braucht dich“ (App 2.5): die Zahl wie das Abzeichen von „Aktuell“ und der dringendste Punkt.
     Ein Tipp öffnet „Aktuell“. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swarm_aktuell_wurzel"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/swarm_widget_hintergrund"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/swarm_aktuell_zahl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="44dp"
        android:gravity="center"
        android:text="–"
        android:textColor="#FF7EE0A1"
        android:textSize="34sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/swarm_widget_aktuell_titel"
            android:textColor="#FFF2B84B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/swarm_aktuell_zeile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#FFE6E9EF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/swarm_aktuell_stand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#FFA7B0BE"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
