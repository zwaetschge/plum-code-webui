<?xml version="1.0" encoding="utf-8"?>
<!-- Ein Favorit im Widget: dunkle Fläche mit bernsteinfarbenem Rand, beim Drücken heller. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A2C0B" />
            <stroke android:width="1dp" android:color="#FFF2B84B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF1C222C" />
            <stroke android:width="1dp" android:color="#66F2B84B" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
