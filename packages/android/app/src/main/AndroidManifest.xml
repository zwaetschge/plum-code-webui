<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ── Core permissions ─────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- POST_NOTIFICATIONS required on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keep the socket alive while agent turns run (AgentWatchService) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Required to use the Quick Settings tile -->
    <uses-permission android:name="android.permission.BIND_QUICK_SETTINGS_TILE" />

    <!-- Dictation in the chat composer; requested at first use. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Vibration for high-priority permission-request notifications -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".ClaudeWebUIApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClaudeCode"
        android:networkSecurityConfig="@xml/network_security_config"
        android:enableOnBackInvokedCallback="true">

        <profileable android:shell="true" />

        <!-- Authenticated chat downloads and APK updates are materialized into
             app-private storage, then shared with Android through this narrow
             content URI boundary. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ── MainActivity ────────────────────────────────────────────────── -->
        <!--
            supportsPictureInPicture: enables PiP for the chat screen.
            configChanges: required so the activity survives PiP ↔ full-screen
            transitions without recreating.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Plum.Starting"
            android:supportsPictureInPicture="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">

            <!-- Launcher intent -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Custom-scheme deep links: claudewebui://session/{id} etc. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="claudewebui" />
            </intent-filter>

            <!--
                HTTPS app links — replace "your-domain.example.com" with your
                actual server domain. Requires a matching /.well-known/assetlinks.json
                on the server for autoVerify to succeed (optional but recommended).
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="your-domain.example.com" />
            </intent-filter>
        </activity>

        <!-- ── ShareReceiver ────────────────────────────────────────────────── -->
        <!--
            Transparent activity that shows a session-picker dialog when another
            app shares content (text, images, files) into Plum Code WebUI.
        -->
        <activity
            android:name=".core.share.ShareReceiver"
            android:exported="true"
            android:theme="@style/Theme.ClaudeCode.Translucent"
            android:noHistory="true">

            <!-- Receive plain text -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
            </intent-filter>

            <!-- Receive images -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>

            <!-- Receive generic files (PDFs, etc.) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/*" />
            </intent-filter>
        </activity>

        <!-- ── NotificationActionReceiver ──────────────────────────────────── -->
        <!--
            Handles inline notification actions (Approve Permission, Dismiss)
            dispatched as BroadcastIntents from the notification's PendingIntent.
        -->
        <receiver
            android:name=".core.notifications.NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.claudewebui.app.action.APPROVE_PERMISSION" />
                <action android:name="com.claudewebui.app.action.DENY_PERMISSION" />
                <action android:name="com.claudewebui.app.action.ANSWER_QUESTION" />
                <action android:name="com.claudewebui.app.action.DISMISS" />
            </intent-filter>
        </receiver>

        <!-- Approve/Deny straight from the Approvals widget -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.claudewebui.app.widget.APPROVE" />
                <action android:name="com.claudewebui.app.widget.DENY" />
            </intent-filter>
        </receiver>

        <!-- Per-instance widget options, launched by the widget host on placement -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.ClaudeCode.Translucent"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Wear OS bridge: receives approval/question answers sent from the watch -->
        <service
            android:name=".wear.WearBridgeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/plum" />
            </intent-filter>
        </service>

        <!-- ── Home-screen widgets ──────────────────────────────────────────── -->
        <!--
            Ten RemoteViews widgets sharing one snapshot cache; refreshed by
            WidgetRefreshWorker. SessionWidgetReceiver keeps its historical
            class name so already-placed widgets survive the update.
        -->
        <receiver
            android:name=".widget.SessionWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/session_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ApprovalsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_approvals">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/approvals_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.QuickGlanceWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_quick_glance">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_glance_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TokensTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_tokens_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tokens_today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.CostTodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_cost_today">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cost_today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ProvidersWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_providers">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/providers_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.ModelsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_models">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/models_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.LimitsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_limits">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/limits_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekChartWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_week_chart">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_chart_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TopSessionsWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_top_sessions">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/top_sessions_widget_info" />
        </receiver>

        <!-- ── AgentWatchService ────────────────────────────────────────────── -->
        <!-- Keeps the socket alive while agent turns run so completion
             notifications arrive even when the app is backgrounded. -->
        <service
            android:name=".core.notifications.AgentWatchService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- ── QuickTileService ─────────────────────────────────────────────── -->
        <!--
            Android Quick Settings tile.
            Requires BIND_QUICK_SETTINGS_TILE permission.
            android:icon is shown in the QS panel — use a 24dp vector drawable.
        -->
        <service
            android:name=".core.tiles.QuickTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="true" />
        </service>

    </application>

</manifest>
