<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Public internet: require HTTPS and trust only the system CA store. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Cleartext HTTP is permitted ONLY for these explicit local/LAN hosts.
         network-security-config cannot express CIDR ranges, so the old
         10.0.0.0 / 172.16.0.0 / 192.168.0.0 "domains" matched nothing useful
         (they are treated as literal hostnames). Each host the app may reach
         over plain http:// has to be listed by name or IP:
           localhost / 127.0.0.1 — on-device loopback
           10.0.2.2              — the Android emulator's host loopback
           192.168.1.36          — the Plum server's LAN address (the public
                                   domains serve valid TLS, so they stay on
                                   HTTPS and are intentionally NOT listed here)
           192.168.1.124         — the Geekom's LAN address, where the server
                                   port is published
         Add further <domain> entries when the server runs under another LAN
         address/hostname. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.36</domain>
        <domain includeSubdomains="false">192.168.1.124</domain>
    </domain-config>

    <!-- Debug builds additionally trust user-added CAs (e.g. a debugging
         proxy); release builds do not. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
