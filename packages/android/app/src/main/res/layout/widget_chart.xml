<?xml version="1.0" encoding="utf-8"?>
<!-- Week chart in the nested-tile style: header, headline, chart tile, footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/widget_pad"
    android:background="@drawable/widget_container">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:paddingTop="2dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/list_header_dot"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:src="@drawable/widget_dot"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:letterSpacing="0.12"
            android:textColor="@color/widget_accent_terracotta"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="Plum" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="10dp"
            android:paddingEnd="2dp"
            android:textSize="13sp"
            android:textColor="@color/widget_text_faint"
            android:text="↻" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chart_headline_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="6dp"
        android:paddingEnd="4dp"
        android:layout_marginTop="2dp"
        android:orientation="horizontal"
        android:gravity="bottom">

        <TextView
            android:id="@+id/widget_headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/widget_text_on_dark"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/chart_headline_sub"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="8dp"
            android:paddingBottom="2dp"
            android:textSize="12sp"
            android:textColor="@color/widget_text_muted"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chart_tile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"
        android:background="@drawable/widget_tile_dark">

        <!-- Bars only: the bitmap stretches to the tile, so text stays out of it. -->
        <ImageView
            android:id="@+id/widget_chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scaleType="fitXY"
            android:contentDescription="@string/widget_chart_description" />

        <LinearLayout
            android:id="@+id/chart_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/chart_day1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
            <TextView
                android:id="@+id/chart_day2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
            <TextView
                android:id="@+id/chart_day3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
            <TextView
                android:id="@+id/chart_day4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
            <TextView
                android:id="@+id/chart_day5"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
            <TextView
                android:id="@+id/chart_day6"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
            <TextView
                android:id="@+id/chart_day7"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="9.5sp"
                android:textColor="@color/widget_text_muted"
                android:maxLines="1"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <include layout="@layout/widget_footer" />
</LinearLayout>
