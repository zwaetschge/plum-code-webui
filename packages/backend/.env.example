# Server
PORT=3001
NODE_ENV=development

# Session Secret (generate a random string)
SESSION_SECRET=your-session-secret-here

# JWT Secret (generate a random string)
JWT_SECRET=your-jwt-secret-here

# OAuth - GitHub
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

# OAuth - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:5173

# Encryption Key for API Keys (32 bytes hex)
ENCRYPTION_KEY=your-32-byte-hex-encryption-key

# Allowed base paths for working directories (comma-separated)
ALLOWED_BASE_PATHS=/home,/Users

# Optional reverse-proxy SSO. Enable only when the backend is reachable
# exclusively through a trusted ForwardAuth proxy such as Authelia.
PROXY_AUTH_ENABLED=false
PROXY_AUTH_EMAIL_HEADERS=Remote-Email,X-Forwarded-Email,X-Auth-Request-Email
PROXY_AUTH_USER_HEADERS=Remote-User,X-Forwarded-User,X-Auth-Request-User
PROXY_AUTH_NAME_HEADERS=Remote-Name,X-Forwarded-Name,X-Auth-Request-Preferred-Username

# CLI auto-update
CLI_AUTO_UPDATE=false
CLI_AUTO_UPDATE_INTERVAL_HOURS=0
CLI_AUTO_UPDATE_PROVIDERS=codex,pi,claude

# Optional CLI provider defaults
CLI_PROVIDER_CODEX_DEFAULT_MODEL=gpt-5.5
CLI_PROVIDER_PI_DEFAULT_MODEL=z-ai/glm-5.1
CLI_PROVIDER_PI_MODELS=
CLI_PROVIDER_CLAUDE_DEFAULT_MODEL=claude-sonnet-5
