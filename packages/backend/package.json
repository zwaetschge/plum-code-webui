{
  "name": "@plum-code-webui/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "permission-prompt": "./dist/cli/permission-prompt.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/normalize-esm-imports.mjs --check && tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "fix:esm-imports": "node scripts/normalize-esm-imports.mjs",
    "test:providers": "pnpm --filter @plum-code-webui/shared run build && tsx scripts/provider-regression-tests.ts",
    "test:design-md": "tsx scripts/design-md-regression-tests.ts",
    "test:style-previews": "tsx scripts/style-preview-regression-tests.ts",
    "test:managed-skills": "tsx scripts/managed-plum-skills-regression-tests.ts",
    "test:lean-skills": "tsx scripts/lean-skill-catalog-regression-tests.ts",
    "test:project-instructions": "tsx scripts/project-instructions-regression-tests.ts",
    "test:android-emulator": "tsx scripts/android-emulator-regression-tests.ts",
    "test:home-assistant": "tsx scripts/home-assistant-status-tests.ts",
    "test:runtime-analytics": "tsx scripts/runtime-analytics-regression-tests.ts",
    "test:usage-limit-history": "tsx scripts/usage-limit-history-regression-tests.ts",
    "test:security-boundaries": "tsx scripts/security-boundaries-regression-tests.ts",
    "test:migrations": "tsx scripts/migration-dry-run.ts",
    "test:session-store": "tsx scripts/sqlite-session-store-regression-tests.ts",
    "test:websocket-auth": "tsx scripts/websocket-authorization-regression-tests.ts",
    "test:websocket-send-ack": "tsx scripts/websocket-send-ack-regression-tests.ts",
    "test:durable-chat": "tsx scripts/durable-chat-regression-tests.ts",
    "test:runner-access": "tsx scripts/runner-access-regression-tests.ts",
    "test:readiness": "tsx scripts/readiness-regression-tests.ts",
    "test:codex-usage-cache": "tsx scripts/codex-usage-cache-regression-tests.ts",
    "test:cli-login": "tsx scripts/cli-login-regression-tests.ts",
    "test:claude-oauth-refresh": "tsx scripts/claude-oauth-refresh-regression-tests.ts",
    "test:opencode-isolation": "tsx scripts/opencode-isolation-regression-tests.ts",
    "test:process-lifecycle": "tsx scripts/managed-process-lifecycle-regression-tests.ts",
    "test:session-icon-thumbnails": "tsx scripts/session-icon-thumbnail-regression-tests.ts",
    "test:chat-media": "pnpm --filter @plum-code-webui/shared run build && tsx scripts/chat-media-regression-tests.ts",
    "test:message-pagination": "tsx scripts/message-pagination-regression-tests.ts",
    "test:analytics-settings": "pnpm --filter @plum-code-webui/shared run build && tsx scripts/analytics-settings-regression-tests.ts",
    "clean": "rm -rf dist",
    "db:migrate": "tsx src/db/migrate.ts",
    "usage:reconcile": "tsx scripts/reconcile-provider-usage-history.ts",
    "usage:backfill-codex": "tsx scripts/backfill-codex-usage-history.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.23.0",
    "@octokit/rest": "^21.0.2",
    "@plum-code-webui/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "http-proxy": "^1.18.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "nanoid": "^5.1.16",
    "node-pty": "^1.0.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "passport-google-oauth20": "^2.0.0",
    "pg": "^8.23.0",
    "simple-git": "^3.36.0",
    "socket.io": "^4.8.1",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.1.0",
    "@types/express-session": "^1.18.1",
    "@types/http-proxy": "^1.17.16",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.2",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/ws": "^8.18.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
