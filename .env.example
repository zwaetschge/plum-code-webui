# Plum Code WebUI - environment variables (template).
# Copy to .env and fill in values, or run ./scripts/install.sh which writes
# this for you interactively. .env is gitignored.

# --- Hosting ---------------------------------------------------------------
# Host port the WebUI is exposed on (container always listens on 3001 internally)
WEBUI_PORT=4545
# Public URL used in OAuth redirects + CORS allowlist seed
FRONTEND_URL=http://localhost:4545
# Comma-separated additional CORS origins (FRONTEND_URL is always allowed)
CORS_ALLOWED_ORIGINS=http://localhost:4545
# IANA timezone used by the backend, CLIs, shell commands, and schedule-like jobs.
# Examples: Europe/Zurich, America/New_York, Etc/UTC
TZ=Europe/Zurich
# Shared memory size for Chromium/Playwright-style browser tests.
WEBUI_SHM_SIZE=1gb

# --- Auth ----------------------------------------------------------------
# REQUIRED. Min 32 chars each. Generate with: openssl rand -base64 48
SESSION_SECRET=
JWT_SECRET=

# Comma-separated email allowlist. Only these emails can sign in via OAuth or
# basic-auth. Leave EMPTY only if the WebUI sits behind a private network or
# an SSO proxy you trust — an empty allowlist + public URL is open signup.
# docker-compose.hub.yml publishes a host port and therefore refuses an empty
# value; provide at least one trusted email there.
AUTH_ALLOWED_EMAILS=

# CLI processes currently share one Unix identity and some provider-config
# homes. Keep execution admin-only; list individual non-admin accounts only when
# you explicitly trust them with runner access. `trusted-users` allows every
# active WebUI account and should remain an intentional operator opt-in until
# process/container isolation exists.
CLI_RUNNER_ACCESS=admin-only
CLI_RUNNER_ALLOWED_EMAILS=

# Optional reverse-proxy SSO. Enable only when the WebUI is reachable
# exclusively through a trusted ForwardAuth proxy such as Authelia.
PROXY_AUTH_ENABLED=false
# Required when proxy auth is on: which peers may assert an identity.
# IPs, CIDRs, or the keywords loopback / private / any. Empty rejects every
# proxy login, on purpose.
PROXY_AUTH_TRUSTED_IPS=
# Defaults match Authelia's common ForwardAuth response headers.
PROXY_AUTH_EMAIL_HEADERS=Remote-Email,X-Forwarded-Email,X-Auth-Request-Email
PROXY_AUTH_USER_HEADERS=Remote-User,X-Forwarded-User,X-Auth-Request-User
PROXY_AUTH_NAME_HEADERS=Remote-Name,X-Forwarded-Name,X-Auth-Request-Preferred-Username

# First-time admin bootstrap. The user with this email gets role='admin' on
# their first login. Defaults to the first AUTH_ALLOWED_EMAILS entry if unset.
SEED_ADMIN_EMAIL=

# Encrypt stored provider keys. docker-compose.hub.yml requires a separate key;
# the portable compose retains SESSION_SECRET as a compatibility fallback.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Volumes (host paths the compose file binds to) ----------------------
# Relative paths resolve against the docker compose project dir.
DATA_DIR=./data
CONFIG_DIR=./config
WORKSPACE_DIR=./workspace

# --- Optional OAuth providers --------------------------------------------
# Leave empty to disable that provider. Configure callback URLs in the
# provider dashboard to match: ${FRONTEND_URL}/auth/<provider>/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

# --- Optional CLI provider tuning ----------------------------------------
# Override the model menus shown in the WebUI per provider. Leave empty to
# auto-discover from the installed CLI.
CLI_PROVIDER_CLAUDE_MODELS=
CLI_PROVIDER_CODEX_MODELS=
CLI_PROVIDER_CODEX_DEFAULT_MODEL=gpt-5.5
# GPT-5.6 WebUI sessions stay single-agent by default to prevent uncontrolled
# delegation loops. Set CODEX_WEBUI_AGENT_MODE=parallel to opt back in, or set
# explicit limits with CODEX_WEBUI_AGENT_MAX_DEPTH / CODEX_WEBUI_AGENT_MAX_THREADS.
# CODEX_WEBUI_AGENT_MODE=parallel
# CODEX_WEBUI_AGENT_MAX_DEPTH=1
# CODEX_WEBUI_AGENT_MAX_THREADS=2
CLI_PROVIDER_OPENCODE_MODELS=
CLI_PROVIDER_OPENCODE_DEFAULT_MODEL=z-ai/glm-5.1
CLI_PROVIDER_OPENCODE_DEFAULT_AGENT=build
# Optional OpenCode communication-style override. Empty = Codex-like default;
# set to 0 or false to disable the injected style reminder.
CLI_PROVIDER_OPENCODE_STYLE_PROMPT=
CLI_PROVIDER_CLAUDE_DEFAULT_MODEL=sonnet

# Runtime CLI autoupdate. Defaults keep the Codex CLI current without touching
# the other provider CLIs unless you opt in with a comma-separated provider list.
CLI_AUTO_UPDATE=true
CLI_AUTO_UPDATE_PROVIDERS=codex
CLI_AUTO_UPDATE_INTERVAL_HOURS=24

# Internal helper calls such as commit-message generation. Empty = Codex first,
# then OpenCode and Claude.
ADMIN_LLM_PROVIDER=
OPENCODE_DEBUG_EVENTS=0

# Optional Codex usage endpoint tuning.
CODEX_USAGE_URL=
CODEX_USER_AGENT=
CODEX_USAGE_TIMEOUT_MS=10000
CODEX_USAGE_CACHE_TTL_MS=60000

# Optional image/integration endpoints. These can also be managed from Settings.
COMFYUI_URL=
OPENAI_API_KEY=

# Optional Home Assistant physical status lights. These can also be configured
# from Settings → Integrations, where the token is encrypted at rest.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Game/content MCP tool binaries. Blender is installed in the image as
# blender-headless; Godot is optional and should point at a mounted Godot 4
# headless/editor binary when validation/export is needed.
GODOT_BIN=
GODOT_TIMEOUT_MS=120000
BLENDER_BIN=blender-headless
BLENDER_TIMEOUT_MS=300000

# Oracle MCP defaults. Browser + Pro + extended thinking uses the signed-in
# ChatGPT plan instead of the OpenAI API key exported for other integrations.
ORACLE_MCP_DEFAULT_ENGINE=browser
ORACLE_BROWSER_MODEL=gpt-5.5-pro
ORACLE_BROWSER_MODEL_STRATEGY=select
ORACLE_BROWSER_THINKING_TIME=extended

# Codex's Landlock workspace sandbox is unreliable inside Docker on many hosts.
# WebUI sessions still map planning/manual/auto/danger modes explicitly, but the
# Docker default is relaxed so shell, browser, MCP, and network workflows work.
CODEX_WEBUI_SANDBOX_MODE=danger-full-access
CODEX_WEBUI_APPROVAL_POLICY=never

# System Chromium is installed in the image and exposed through this wrapper.
CHROME_BIN=/usr/local/bin/plum-chromium
CHROMIUM_BIN=/usr/local/bin/plum-chromium
CHROMIUM_PATH=/usr/local/bin/plum-chromium
BROWSER=/usr/local/bin/plum-chromium
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/local/bin/plum-chromium
PUPPETEER_EXECUTABLE_PATH=/usr/local/bin/plum-chromium
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
PUPPETEER_SKIP_DOWNLOAD=1
PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=1

# Additional workspace base paths the in-container CLI is allowed to access.
# Defaults to /workspace (the volume above). Comma-separated.
ALLOWED_BASE_PATHS=/workspace

# --- Operations and retention --------------------------------------------
# Optional Docker release API for provider sessions. All five switches default
# to 0 in the compose overlay. Enable them together only for trusted release
# operators while CLI_RUNNER_ACCESS remains admin-only. NETWORKS is required by
# Docker Compose to inspect external networks; the main WebUI never receives the
# raw Docker socket, while EXEC and VOLUMES remain disabled.
DOCKER_PROXY_CONTAINERS=0
DOCKER_PROXY_IMAGES=0
DOCKER_PROXY_NETWORKS=0
DOCKER_PROXY_BUILD=0
DOCKER_PROXY_POST=0

# The repair-bot accepts these optional readiness timings. Defaults allow up
# to three minutes for the candidate and, if needed, the rollback release.
REBUILD_READINESS_ATTEMPTS=36
REBUILD_READINESS_INTERVAL_SECONDS=5

# Used by: node scripts/plum-maintenance.mjs
# The command first creates and validates an online SQLite backup, then prunes
# only Plum-managed backups, data logs, and provider session JSONL files older
# than these limits. Preview with --dry-run before scheduling it.
PLUM_BACKUP_RETENTION_DAYS=14
PLUM_LOG_RETENTION_DAYS=14
PLUM_SESSION_RETENTION_DAYS=30

# --- Optional preview subdomain ------------------------------------------
# If set, dev servers spawned in /workspace get proxied at this hostname.
# PREVIEW_HOSTNAME=preview.example.com
